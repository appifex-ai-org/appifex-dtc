import { describe, it, expect } from 'vitest'
import { createMock<%= it.entity.name %>Repository } from '../services/Mock<%= it.entity.name %>Repository'

describe('Mock<%= it.entity.name %>Repository', () => {
  it('list returns seed data', async () => {
    const repo = createMock<%= it.entity.name %>Repository()
    const items = await repo.list()
    expect(items.length).toBeGreaterThan(0)
  })

  it('getById returns seed item', async () => {
    const repo = createMock<%= it.entity.name %>Repository()
    const item = await repo.getById('mock-<%= it.entity.name.toLowerCase() %>-001')
    expect(item).toBeDefined()
  })

  it('create adds item', async () => {
    const repo = createMock<%= it.entity.name %>Repository()
    const newItem = {
      id: 'mock-<%= it.entity.name.toLowerCase() %>-new',
<% for (const field of it.entity.fields) { %>
<% if (field.type === 'string') { %>
      <%= field.name %>: 'Test <%= field.name %>',
<% } else if (field.type === 'number') { %>
      <%= field.name %>: 99,
<% } else if (field.type === 'boolean') { %>
      <%= field.name %>: true,
<% } else if (field.type === 'date') { %>
      <%= field.name %>: new Date(),
<% } else if (field.type === 'reference') { %>
      <%= field.name %>: 'mock-ref-new',
<% } else if (field.type === 'array') { %>
      <%= field.name %>: [],
<% } %>
<% } %>
      ownerId: 'mock-user-001',
    }
    const created = await repo.create(newItem)
    expect(created.id).toBe('mock-<%= it.entity.name.toLowerCase() %>-new')
  })

  it('update modifies item', async () => {
    const repo = createMock<%= it.entity.name %>Repository()
    const newItem = {
      id: 'mock-<%= it.entity.name.toLowerCase() %>-update',
<% for (const field of it.entity.fields) { %>
<% if (field.type === 'string') { %>
      <%= field.name %>: 'Original <%= field.name %>',
<% } else if (field.type === 'number') { %>
      <%= field.name %>: 10,
<% } else if (field.type === 'boolean') { %>
      <%= field.name %>: false,
<% } else if (field.type === 'date') { %>
      <%= field.name %>: new Date(),
<% } else if (field.type === 'reference') { %>
      <%= field.name %>: 'mock-ref-update',
<% } else if (field.type === 'array') { %>
      <%= field.name %>: [],
<% } %>
<% } %>
      ownerId: 'mock-user-001',
    }
    await repo.create(newItem)

    const updatedItem = { ...newItem,
<% if (it.entity.fields.length > 0) { %>
<% const firstField = it.entity.fields[0] %>
<% if (firstField.type === 'string') { %>
      <%= firstField.name %>: 'Updated <%= firstField.name %>',
<% } else if (firstField.type === 'number') { %>
      <%= firstField.name %>: 20,
<% } else if (firstField.type === 'boolean') { %>
      <%= firstField.name %>: true,
<% } %>
<% } %>
    }
    const result = await repo.update(updatedItem)
    expect(result.id).toBe('mock-<%= it.entity.name.toLowerCase() %>-update')
  })

  it('delete removes item', async () => {
    const repo = createMock<%= it.entity.name %>Repository()
    const newItem = {
      id: 'mock-<%= it.entity.name.toLowerCase() %>-delete',
<% for (const field of it.entity.fields) { %>
<% if (field.type === 'string') { %>
      <%= field.name %>: 'Delete me',
<% } else if (field.type === 'number') { %>
      <%= field.name %>: 0,
<% } else if (field.type === 'boolean') { %>
      <%= field.name %>: true,
<% } else if (field.type === 'date') { %>
      <%= field.name %>: new Date(),
<% } else if (field.type === 'reference') { %>
      <%= field.name %>: 'mock-ref-delete',
<% } else if (field.type === 'array') { %>
      <%= field.name %>: [],
<% } %>
<% } %>
      ownerId: 'mock-user-001',
    }
    await repo.create(newItem)
    await repo.delete('mock-<%= it.entity.name.toLowerCase() %>-delete')
    const found = await repo.getById('mock-<%= it.entity.name.toLowerCase() %>-delete')
    expect(found).toBeUndefined()
  })

  // Simulate error: serverError — auto-clears after one call
  it('simulateError causes list to throw', async () => {
    const repo = createMock<%= it.entity.name %>Repository()
    repo.simulateError('serverError')
    await expect(repo.list()).rejects.toThrow()
  })

  it('error clears after one use', async () => {
    const repo = createMock<%= it.entity.name %>Repository()
    repo.simulateError('serverError')
    // First call throws
    await expect(repo.list()).rejects.toThrow()
    // Second call should succeed (one-shot consumption)
    const items = await repo.list()
    expect(items.length).toBeGreaterThan(0)
  })
})
