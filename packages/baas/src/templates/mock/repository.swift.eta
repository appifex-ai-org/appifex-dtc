// MOCK ONLY: Replace Mock<%= it.entity.name %>Repository with Firestore<%= it.entity.name %>Repository (or Supabase<%= it.entity.name %>Repository)
// in ServiceConfiguration.swift to switch to a live backend.
import Foundation

protocol <%= it.entity.name %>Repository {
    func create(_ item: <%= it.entity.name %>) async throws -> <%= it.entity.name %>
    func getById(_ id: String) async throws -> <%= it.entity.name %>?
    func list() async throws -> [<%= it.entity.name %>]
    func update(_ item: <%= it.entity.name %>) async throws -> <%= it.entity.name %>
    func delete(_ id: String) async throws
}

enum MockApiError: Error {
    case notFound
    case networkTimeout
    case serverError
}

final class Mock<%= it.entity.name %>Repository: <%= it.entity.name %>Repository {
    private var pendingError: MockApiError?

    func simulateError(_ error: MockApiError) {
        pendingError = error
    }

    private func checkError() throws {
        if let error = pendingError { pendingError = nil; throw error }
    }

    private var items: [<%= it.entity.name %>] = [
<% for (let i = 1; i <= 3; i++) { %>
        <%= it.entity.name %>(
            id: "mock-<%= it.entity.name.toLowerCase() %>-00<%= i %>",
<% for (const field of it.entity.fields) { %>
<% if (field.type === 'string') { %>
            <%= field.name %>: "Sample <%= field.name %> <%= i %>",
<% } else if (field.type === 'number') { %>
            <%= field.name %>: <%= i * 10 + 2 %>,
<% } else if (field.type === 'boolean') { %>
            <%= field.name %>: true,
<% } else if (field.type === 'date') { %>
            <%= field.name %>: Date(timeIntervalSince1970: <%= 1700000000 + i * 86400 %>),
<% } else if (field.type === 'reference') { %>
            <%= field.name %>: "mock-ref-00<%= i %>",
<% } else if (field.type === 'array') { %>
            <%= field.name %>: [],
<% } %>
<% } %>
            ownerId: "mock-user-001"
        ),
<% } %>
    ]

    func create(_ item: <%= it.entity.name %>) async throws -> <%= it.entity.name %> {
        try checkError()
        items.append(item)
        return item
    }

    func getById(_ id: String) async throws -> <%= it.entity.name %>? {
        try checkError()
        return items.first { $0.id == id }
    }

    func list() async throws -> [<%= it.entity.name %>] {
        try checkError()
        return items
    }

    func update(_ item: <%= it.entity.name %>) async throws -> <%= it.entity.name %> {
        try checkError()
        if let index = items.firstIndex(where: { $0.id == item.id }) {
            items[index] = item
        }
        return item
    }

    func delete(_ id: String) async throws {
        try checkError()
        items.removeAll { $0.id == id }
    }
}
