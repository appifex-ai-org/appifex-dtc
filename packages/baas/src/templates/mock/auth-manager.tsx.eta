// src/services/MockAuthManager.tsx -- generated by appifex-dtc -- mock provider
// MOCK ONLY -- swap AuthContext value source in ServiceConfiguration.tsx to switch to live backend
import React, { createContext, useContext, useState, useRef, useCallback } from 'react'

export type MockAuthError = 'wrongPassword' | 'userNotFound' | 'networkFailure'

export interface AuthContextValue {
  isAuthenticated: boolean
  user: {
    uid: string
    email: string
    displayName: string
    emailVerified: boolean
    isAnonymous: boolean
    photoURL: string | null
  }
  signIn: (email: string, password: string) => Promise<void>
  signUp: (email: string, password: string) => Promise<void>
  signOut: () => void
  sendPasswordReset: (email: string) => Promise<void>
  confirmPasswordReset: (code: string, newPassword: string) => Promise<void>
  simulateError: (error: MockAuthError) => void
}

const AuthContext = createContext<AuthContextValue | null>(null)

export function MockAuthProvider({ children }: { children: React.ReactNode }) {
  const [isAuthenticated, setIsAuthenticated] = useState(true)
  const pendingErrorRef = useRef<MockAuthError | null>(null)

  const checkError = useCallback(() => {
    const err = pendingErrorRef.current
    if (err) {
      pendingErrorRef.current = null
      throw new Error(err)
    }
  }, [])

  const simulateError = useCallback((error: MockAuthError) => {
    pendingErrorRef.current = error
  }, [])

  const signIn = useCallback(async (_email: string, _password: string) => {
    checkError()
    setIsAuthenticated(true)
  }, [checkError])

  const signUp = useCallback(async (_email: string, _password: string) => {
    checkError()
    setIsAuthenticated(true)
  }, [checkError])

  const signOut = useCallback(() => {
    setIsAuthenticated(false)
  }, [])

  const sendPasswordReset = useCallback(async (_email: string) => {
    checkError()
  }, [checkError])

  const confirmPasswordReset = useCallback(async (_code: string, _newPassword: string) => {
    checkError()
  }, [checkError])

  const value: AuthContextValue = {
    isAuthenticated,
    user: {
      uid: '<%= it.mockUser.uid %>',
      email: '<%= it.mockUser.email %>',
      displayName: '<%= it.mockUser.displayName %>',
      emailVerified: <%= it.mockUser.emailVerified %>,
      isAnonymous: false,
      photoURL: null,
    },
    signIn,
    signUp,
    signOut,
    sendPasswordReset,
    confirmPasswordReset,
    simulateError,
  }

  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>
}

export function useAuth(): AuthContextValue {
  const context = useContext(AuthContext)
  if (!context) {
    throw new Error('useAuth must be used within a MockAuthProvider')
  }
  return context
}
