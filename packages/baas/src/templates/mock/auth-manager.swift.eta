import Foundation

protocol AuthManaging: ObservableObject {
    var isAuthenticated: Bool { get }
    func signIn(email: String, password: String) async throws
    func signUp(email: String, password: String) async throws
    func signOut() throws
    func sendPasswordReset(email: String) async throws
    func confirmPasswordReset(code: String, newPassword: String) async throws
}

enum MockAuthError: Error {
    case wrongPassword
    case userNotFound
    case networkFailure
}

final class MockAuthManager: ObservableObject, AuthManaging {
    static let shared = MockAuthManager()

    @Published var isAuthenticated: Bool = true

    let uid = "mock-user-001"
    let email = "mock@example.com"
    let displayName = "Mock User"
    let emailVerified = true
    let isAnonymous = false
    let photoURL: String? = nil

    private var pendingError: MockAuthError?

    init() {}

    func simulateError(_ error: MockAuthError) {
        pendingError = error
    }

    func signIn(email: String, password: String) async throws {
        if let error = pendingError {
            pendingError = nil
            throw error
        }
        isAuthenticated = true
    }

    func signUp(email: String, password: String) async throws {
        if let error = pendingError {
            pendingError = nil
            throw error
        }
        isAuthenticated = true
    }

    func signOut() throws {
        isAuthenticated = false
    }

    func sendPasswordReset(email: String) async throws {
        if let error = pendingError {
            pendingError = nil
            throw error
        }
    }

    func confirmPasswordReset(code: String, newPassword: String) async throws {
        if let error = pendingError {
            pendingError = nil
            throw error
        }
    }
}
