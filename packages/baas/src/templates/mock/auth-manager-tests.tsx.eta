// Generated by appifex-dtc — mock provider
import { describe, it, expect } from 'vitest'
import { render, act } from '@testing-library/react'
import React from 'react'
import { MockAuthProvider, useAuth } from '../services/MockAuthManager'

function AuthConsumer() {
  const { isAuthenticated } = useAuth()
  return <div data-testid="status">{isAuthenticated ? 'authenticated' : 'unauthenticated'}</div>
}

function renderWithAuth(ui?: React.ReactElement) {
  return render(
    <MockAuthProvider>
      {ui ?? <AuthConsumer />}
    </MockAuthProvider>
  )
}

describe('MockAuthManager (TEST-01, TEST-02, TEST-03)', () => {
  it('provides authenticated state by default', () => {
    const { getByTestId } = renderWithAuth()
    expect(getByTestId('status').textContent).toBe('authenticated')
  })

  it('signOut changes state to unauthenticated', async () => {
    let authRef: ReturnType<typeof useAuth> | null = null
    function Capture() {
      authRef = useAuth()
      return <AuthConsumer />
    }
    const { getByTestId } = renderWithAuth(<Capture />)

    await act(() => {
      authRef!.signOut()
    })

    expect(getByTestId('status').textContent).toBe('unauthenticated')
  })

  // Simulate error: wrongPassword — auto-clears after one call
  it('simulateError causes next signIn to throw (TEST-02)', async () => {
    let authRef: ReturnType<typeof useAuth> | null = null
    function Capture() {
      authRef = useAuth()
      return <AuthConsumer />
    }
    renderWithAuth(<Capture />)

    act(() => {
      authRef!.simulateError('wrongPassword')
    })

    await expect(authRef!.signIn('mock@example.com', 'wrong')).rejects.toThrow('wrongPassword')
  })

  it('error auto-clears after one use (D-10)', async () => {
    let authRef: ReturnType<typeof useAuth> | null = null
    function Capture() {
      authRef = useAuth()
      return <AuthConsumer />
    }
    renderWithAuth(<Capture />)

    act(() => {
      authRef!.simulateError('wrongPassword')
    })

    // First call throws
    await expect(authRef!.signIn('mock@example.com', 'wrong')).rejects.toThrow()

    // Second call succeeds (one-shot consumption)
    await expect(authRef!.signIn('mock@example.com', 'password')).resolves.toBeUndefined()
  })

  it('fresh render provides clean state (TEST-03)', () => {
    const { getByTestId: getFirst } = renderWithAuth()
    expect(getFirst('status').textContent).toBe('authenticated')

    const { getByTestId: getSecond } = renderWithAuth()
    expect(getSecond('status').textContent).toBe('authenticated')
  })
})
