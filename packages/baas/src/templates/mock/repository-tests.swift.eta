    // Simulate error: serverError — auto-clears after one call
    func testSimulateErrorCausesListToThrow() async {
        repo.simulateError(.serverError)
        do {
            _ = try await repo.list()
            XCTFail("Expected MockApiError.serverError")
        } catch {
            XCTAssertTrue(error is MockApiError)
