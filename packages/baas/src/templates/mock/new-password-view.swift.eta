// Sources/Auth/NewPasswordView.swift — generated by appifex-dtc — mock provider
import SwiftUI

struct NewPasswordView: View {
    @StateObject private var authManager = MockAuthManager.shared
    let code: String
    @State private var newPassword = ""
    @State private var confirmPassword = ""
    @State private var error: String?
    @State private var isLoading = false
    @State private var isSuccess = false

    var body: some View {
        VStack(spacing: 24) {
            Text("Set new password")
                .font(.title)
                .fontWeight(.bold)

            if isSuccess {
                Text("Your password has been updated. You can now sign in.")
                    .font(.body)
                    .multilineTextAlignment(.center)
            } else {
                VStack(spacing: 16) {
                    SecureField("New password", text: $newPassword)
                        .textContentType(.newPassword)
                        .textFieldStyle(.roundedBorder)
                        .disabled(isLoading)

                    SecureField("Confirm password", text: $confirmPassword)
                        .textContentType(.newPassword)
                        .textFieldStyle(.roundedBorder)
                        .disabled(isLoading)
                }

                if let error {
                    Text(error)
                        .font(.caption)
                        .foregroundColor(.red)
                }

                Button(action: updatePassword) {
                    if isLoading {
                        ProgressView()
                            .frame(height: 20)
                    } else {
                        Text("Update password")
                    }
                }
                .frame(maxWidth: .infinity, minHeight: 44)
                .background(Color.accentColor)
                .foregroundColor(.white)
                .cornerRadius(12)
                .disabled(isLoading)
            }
        }
        .padding(.horizontal, 16)
        .padding(.vertical, 32)
    }

    private func updatePassword() {
        guard newPassword.count >= 8 else {
            error = "Password must be at least 8 characters."
            return
        }
        guard newPassword == confirmPassword else {
            error = "Passwords do not match."
            return
        }
        isLoading = true
        error = nil
        Task {
            do {
                try await authManager.confirmPasswordReset(code: code, newPassword: newPassword)
                isSuccess = true
            } catch {
                self.error = "Connection failed. Check your internet and try again."
            }
            isLoading = false
        }
    }
}
