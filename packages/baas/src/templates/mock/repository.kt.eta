package repositories

interface <%= it.entity.name %>Repository {
    suspend fun create(item: <%= it.entity.name %>): <%= it.entity.name %>
    suspend fun getById(id: String): <%= it.entity.name %>?
    suspend fun list(): List<<%= it.entity.name %>>
    suspend fun update(item: <%= it.entity.name %>): <%= it.entity.name %>
    suspend fun delete(id: String)
}

sealed class MockApiError : Exception() {
    object NotFound : MockApiError()
    object NetworkTimeout : MockApiError()
    object ServerError : MockApiError()
}

class Mock<%= it.entity.name %>Repository : <%= it.entity.name %>Repository {
    private var pendingError: Exception? = null

    fun simulateError(error: Exception) {
        pendingError = error
    }

    private fun checkError() {
        pendingError?.let { err -> pendingError = null; throw err }
    }

    private val items = mutableListOf(
<% for (let i = 1; i <= 3; i++) { %>
        <%= it.entity.name %>(
            id = "mock-<%= it.entity.name.toLowerCase() %>-00<%= i %>",
<% for (const field of it.entity.fields) { %>
<% if (field.type === 'string') { %>
            <%= field.name %> = "Sample <%= field.name %> <%= i %>",
<% } else if (field.type === 'number') { %>
            <%= field.name %> = <%= i * 10 + 2 %>,
<% } else if (field.type === 'boolean') { %>
            <%= field.name %> = true,
<% } else if (field.type === 'date') { %>
            <%= field.name %> = java.util.Date(<%= (1700000000 + i * 86400) * 1000 %>L),
<% } else if (field.type === 'reference') { %>
            <%= field.name %> = "mock-ref-00<%= i %>",
<% } else if (field.type === 'array') { %>
            <%= field.name %> = emptyList(),
<% } %>
<% } %>
            ownerId = "mock-user-001"
        ),
<% } %>
    )

    override suspend fun create(item: <%= it.entity.name %>): <%= it.entity.name %> {
        checkError()
        items.add(item)
        return item
    }

    override suspend fun getById(id: String): <%= it.entity.name %>? {
        checkError()
        return items.find { it.id == id }
    }

    override suspend fun list(): List<<%= it.entity.name %>> {
        checkError()
        return items.toList()
    }

    override suspend fun update(item: <%= it.entity.name %>): <%= it.entity.name %> {
        checkError()
        val index = items.indexOfFirst { it.id == item.id }
        if (index >= 0) items[index] = item
        return item
    }

    override suspend fun delete(id: String) {
        checkError()
        items.removeAll { it.id == id }
    }
}
