/** React test harness — wraps auth screens with MockAuthProvider */
// Generated by appifex-dtc — mock provider
import React, { useState } from 'react'
import { ServiceConfiguration } from '../services/ServiceConfiguration'
import { LoginPage } from '../pages/auth/LoginPage'
import { SignupPage } from '../pages/auth/SignupPage'
import { ResetPasswordPage } from '../pages/auth/ResetPasswordPage'
import { NewPasswordPage } from '../pages/auth/NewPasswordPage'

type Screen = 'login' | 'signup' | 'reset-password' | 'new-password'

export function AuthTestHarness() {
  const [screen, setScreen] = useState<Screen>('login')

  return (
    <ServiceConfiguration>
      <nav style={{ padding: 8, borderBottom: '1px solid #eee' }}>
        {(['login', 'signup', 'reset-password', 'new-password'] as Screen[]).map(s => (
          <button key={s} onClick={() => setScreen(s)} style={{ marginRight: 8 }}>{s}</button>
        ))}
      </nav>
      {screen === 'login' && <LoginPage />}
      {screen === 'signup' && <SignupPage />}
      {screen === 'reset-password' && <ResetPasswordPage />}
      {screen === 'new-password' && <NewPasswordPage />}
    </ServiceConfiguration>
  )
}
