// MOCK ONLY -- swap createMock<%= it.entity.name %>Repository with a live repository factory
// in ServiceConfiguration.tsx to switch to a live backend.

export interface <%= it.entity.name %> {
  id: string
<% for (const field of it.entity.fields) { %>
<% if (field.type === 'string' || field.type === 'reference') { %>
  <%= field.name %>: string
<% } else if (field.type === 'number') { %>
  <%= field.name %>: number
<% } else if (field.type === 'boolean') { %>
  <%= field.name %>: boolean
<% } else if (field.type === 'date') { %>
  <%= field.name %>: Date
<% } else if (field.type === 'array') { %>
  <%= field.name %>: unknown[]
<% } %>
<% } %>
  ownerId: string
}

export interface <%= it.entity.name %>Repository {
  create(item: <%= it.entity.name %>): Promise<<%= it.entity.name %>>
  getById(id: string): Promise<<%= it.entity.name %> | undefined>
  list(): Promise<<%= it.entity.name %>[]>
  update(item: <%= it.entity.name %>): Promise<<%= it.entity.name %>>
  delete(id: string): Promise<void>
  simulateError(error: MockApiError): void
}

export type MockApiError = 'notFound' | 'networkTimeout' | 'serverError'

export function createMock<%= it.entity.name %>Repository(): <%= it.entity.name %>Repository {
  let pendingError: MockApiError | null = null

  function checkError() {
    if (pendingError) {
      const err = pendingError
      pendingError = null
      throw new Error(err)
    }
  }

  const items: <%= it.entity.name %>[] = [
<% for (let i = 1; i <= 3; i++) { %>
    {
      id: 'mock-<%= it.entity.name.toLowerCase() %>-00<%= i %>',
<% for (const field of it.entity.fields) { %>
<% if (field.type === 'string') { %>
      <%= field.name %>: 'Sample <%= field.name %> <%= i %>',
<% } else if (field.type === 'number') { %>
      <%= field.name %>: <%= i * 10 + 2 %>,
<% } else if (field.type === 'boolean') { %>
      <%= field.name %>: true,
<% } else if (field.type === 'date') { %>
      <%= field.name %>: new Date(<%= (1700000000 + i * 86400) * 1000 %>),
<% } else if (field.type === 'reference') { %>
      <%= field.name %>: 'mock-ref-00<%= i %>',
<% } else if (field.type === 'array') { %>
      <%= field.name %>: [],
<% } %>
<% } %>
      ownerId: 'mock-user-001',
    },
<% } %>
  ]

  return {
    async create(item) {
      checkError()
      items.push(item)
      return item
    },

    async getById(id) {
      checkError()
      return items.find((item) => item.id === id)
    },

    async list() {
      checkError()
      return [...items]
    },

    async update(item) {
      checkError()
      const index = items.findIndex((existing) => existing.id === item.id)
      if (index !== -1) {
        items[index] = item
      }
      return item
    },

    async delete(id) {
      checkError()
      const index = items.findIndex((item) => item.id === id)
      if (index !== -1) {
        items.splice(index, 1)
      }
    },

    simulateError(error: MockApiError) {
      pendingError = error
    },
  }
}
