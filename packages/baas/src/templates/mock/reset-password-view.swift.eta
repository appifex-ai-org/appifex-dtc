// Sources/Auth/ResetPasswordView.swift — generated by appifex-dtc — mock provider
import SwiftUI

struct ResetPasswordView: View {
    @StateObject private var authManager = MockAuthManager.shared
    @State private var email = ""
    @State private var error: String?
    @State private var isLoading = false
    @State private var isSuccess = false

    var body: some View {
        VStack(spacing: 24) {
            Text("Reset password")
                .font(.title)
                .fontWeight(.bold)

            if isSuccess {
                Text("Check your inbox \u{2014} we sent a reset link to \(email).")
                    .font(.body)
                    .multilineTextAlignment(.center)
            } else {
                VStack(spacing: 16) {
                    TextField("Email", text: $email)
                        .textContentType(.emailAddress)
                        .keyboardType(.emailAddress)
                        .autocapitalization(.none)
                        .textFieldStyle(.roundedBorder)
                        .disabled(isLoading)
                }

                if let error {
                    Text(error)
                        .font(.caption)
                        .foregroundColor(.red)
                }

                Button(action: sendReset) {
                    if isLoading {
                        ProgressView()
                            .frame(height: 20)
                    } else {
                        Text("Send reset link")
                    }
                }
                .frame(maxWidth: .infinity, minHeight: 44)
                .background(Color.accentColor)
                .foregroundColor(.white)
                .cornerRadius(12)
                .disabled(isLoading)
            }
        }
        .padding(.horizontal, 16)
        .padding(.vertical, 32)
    }

    private func sendReset() {
        guard !email.isEmpty, email.contains("@"), email.contains(".") else {
            error = "Please enter a valid email address."
            return
        }
        isLoading = true
        error = nil
        Task {
            do {
                try await authManager.sendPasswordReset(email: email)
                isSuccess = true
            } catch {
                self.error = "Connection failed. Check your internet and try again."
            }
            isLoading = false
        }
    }
}
