// src/pages/auth/ResetPasswordPage.tsx -- generated by appifex-dtc -- mock provider
import React, { useState } from 'react'
import { useAuth } from '../services/MockAuthManager'

const styles = {
  page: { display: 'flex', justifyContent: 'center', alignItems: 'center', minHeight: '100vh', background: '#ffffff', fontFamily: 'inherit' } as const,
  card: { width: '100%', maxWidth: 400, padding: '32px 16px' } as const,
  heading: { fontSize: 24, fontWeight: 700, lineHeight: 1.2, marginBottom: 24 } as const,
  input: { display: 'block', width: '100%', padding: '12px 16px', marginBottom: 16, fontSize: 16, background: '#f5f5f5', border: '1px solid #e0e0e0', borderRadius: 8, boxSizing: 'border-box' as const },
  button: { display: 'block', width: '100%', padding: '12px', minHeight: 44, fontSize: 16, fontWeight: 700, color: '#ffffff', background: '#0070f3', border: 'none', borderRadius: 8, cursor: 'pointer' } as const,
  buttonDisabled: { opacity: 0.7, cursor: 'not-allowed' } as const,
  error: { color: '#d32f2f', fontSize: 14, marginTop: 8, lineHeight: 1.4 } as const,
  link: { marginTop: 16, fontSize: 16, textAlign: 'center' as const } as const,
  success: { fontSize: 16, lineHeight: 1.5, textAlign: 'center' as const } as const,
}

export function ResetPasswordPage() {
  const { sendPasswordReset } = useAuth()
  const [email, setEmail] = useState('')
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [success, setSuccess] = useState(false)

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!email || !email.includes('@') || !email.includes('.')) {
      setError('Please enter a valid email address.')
      return
    }
    setLoading(true)
    setError(null)
    try {
      await sendPasswordReset(email)
      setSuccess(true)
    } catch {
      setError('Something went wrong. Please try again.')
    } finally {
      setLoading(false)
    }
  }

  return (
    <div style={styles.page}>
      <div style={styles.card}>
        <h1 style={styles.heading}>Reset password</h1>
        {success ? (
          <p style={styles.success}>Check your email for a reset link.</p>
        ) : (
          <form onSubmit={handleSubmit}>
            <input
              type="email"
              aria-label="Email address"
              placeholder="Email address"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              disabled={loading}
              style={styles.input}
            />
            {error && <p role="alert" style={styles.error}>{error}</p>}
            <button
              type="submit"
              disabled={loading}
              style={loading ? { ...styles.button, ...styles.buttonDisabled } : styles.button}
            >
              {loading ? '...' : 'Send reset link'}
            </button>
          </form>
        )}
      </div>
    </div>
  )
}
