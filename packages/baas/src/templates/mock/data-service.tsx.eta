// MOCK ONLY -- swap MockDataProvider repository sources in ServiceConfiguration.tsx to switch to live backend
import React, { createContext, useContext, useMemo } from 'react'
<% for (const entity of it.schema.entities) { %>
import { createMock<%= entity.name %>Repository, type <%= entity.name %>Repository } from './Mock<%= entity.name %>Repository'
<% } %>

export interface DataContextValue {
<% for (const entity of it.schema.entities) { %>
  <%= entity.name.charAt(0).toLowerCase() + entity.name.slice(1) %>: <%= entity.name %>Repository
<% } %>
}

const DataContext = createContext<DataContextValue | null>(null)

export function MockDataProvider({ children }: { children: React.ReactNode }) {
  const repositories = useMemo<DataContextValue>(() => ({
<% for (const entity of it.schema.entities) { %>
    <%= entity.name.charAt(0).toLowerCase() + entity.name.slice(1) %>: createMock<%= entity.name %>Repository(),
<% } %>
  }), [])

  return <DataContext.Provider value={repositories}>{children}</DataContext.Provider>
}

export function useData(): DataContextValue {
  const context = useContext(DataContext)
  if (!context) {
    throw new Error('useData must be used within a MockDataProvider')
  }
  return context
}
