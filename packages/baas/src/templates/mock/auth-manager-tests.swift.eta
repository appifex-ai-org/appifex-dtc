// Generated by appifex-dtc — mock provider
import XCTest
@testable import YourApp

final class MockAuthManagerTests: XCTestCase {
    var auth: MockAuthManager!

    override func setUp() {
        super.setUp()
        auth = MockAuthManager()
    }

    func testFactoryFreshInstanceStartsAuthenticated() {
        XCTAssertTrue(auth.isAuthenticated)
    }

    func testSignInSetsAuthenticated() async throws {
        auth.isAuthenticated = false
        try await auth.signIn(email: "mock@example.com", password: "password")
        XCTAssertTrue(auth.isAuthenticated)
    }

    func testSignUpSetsAuthenticated() async throws {
        auth.isAuthenticated = false
        try await auth.signUp(email: "mock@example.com", password: "password")
        XCTAssertTrue(auth.isAuthenticated)
    }

    func testSignOutClearsAuthenticated() throws {
        try auth.signOut()
        XCTAssertFalse(auth.isAuthenticated)
    }

    func testSendPasswordResetDoesNotThrow() async throws {
        try await auth.sendPasswordReset(email: "mock@example.com")
    }

    func testConfirmPasswordResetDoesNotThrow() async throws {
        try await auth.confirmPasswordReset(code: "123456", newPassword: "newpass")
    }

    func testSimulateErrorWrongPasswordCausesSignInToThrow() async {
        auth.simulateError(.wrongPassword)
        do {
            try await auth.signIn(email: "mock@example.com", password: "wrong")
            XCTFail("Expected MockAuthError.wrongPassword")
        } catch {
            XCTAssertTrue(error is MockAuthError)
        }
    }

    func testSimulateErrorNetworkFailureCausesSignUpToThrow() async {
        auth.simulateError(.networkFailure)
        do {
            try await auth.signUp(email: "mock@example.com", password: "password")
            XCTFail("Expected MockAuthError.networkFailure")
        } catch {
            XCTAssertTrue(error is MockAuthError)
        }
    }

    // Simulate error: wrongPassword — auto-clears after one call
    func testErrorClearsAfterOneUse() async throws {
        auth.simulateError(.wrongPassword)
        do {
            try await auth.signIn(email: "mock@example.com", password: "wrong")
            XCTFail("Expected error")
        } catch {
            // First call throws — expected
        }
        // Second call should succeed (one-shot consumption)
        try await auth.signIn(email: "mock@example.com", password: "password")
        XCTAssertTrue(auth.isAuthenticated)
    }
}
