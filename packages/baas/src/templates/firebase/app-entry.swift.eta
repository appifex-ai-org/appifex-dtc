// Sources/AppEntry.swift — generated by baas_auth phase
import SwiftUI
import FirebaseCore
import FirebaseAuth

class AppDelegate: NSObject, UIApplicationDelegate {
    func application(_ application: UIApplication,
                     didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]? = nil) -> Bool {
        // Credentials loaded from GoogleService-Info.plist (placeholder — replace before shipping)
        FirebaseApp.configure()
        return true
    }

    // Universal link handler for Firebase password reset deep links
    // (Firebase Dynamic Links deprecated August 2025 — use Firebase Hosting Universal Links)
    func application(_ application: UIApplication,
                     continue userActivity: NSUserActivity,
                     restorationHandler: @escaping ([UIUserActivityRestoring]?) -> Void) -> Bool {
        if userActivity.activityType == NSUserActivityTypeBrowsingWeb,
           let url = userActivity.webpageURL {
            // Extract oobCode from the Universal Link URL for password reset
            let components = URLComponents(url: url, resolvingAgainstBaseURL: false)
            if let oobCode = components?.queryItems?.first(where: { $0.name == "oobCode" })?.value {
                NotificationCenter.default.post(
                    name: .passwordResetDeepLink,
                    object: nil,
                    userInfo: ["code": oobCode]
                )
            }
        }
        return true
    }
}

extension Notification.Name {
    static let passwordResetDeepLink = Notification.Name("passwordResetDeepLink")
}

@main
struct AppEntry: App {
    @UIApplicationDelegateAdaptor(AppDelegate.self) var delegate
    @StateObject private var authManager = AuthManager.shared

    var body: some Scene {
        WindowGroup {
            if authManager.isAuthenticated {
                ContentView()
            } else {
                NavigationStack {
                    LoginView()
                }
            }
        }
    }
}
