import Foundation

@MainActor
@Observable
final class <%= it.entity.name %>DataService {
    private let repository: any <%= it.entity.name %>Repository
    var items: [<%= it.entity.name %>] = []
    var isLoading = false
    var error: Error?

    init(repository: any <%= it.entity.name %>Repository = Firestore<%= it.entity.name %>Repository()) {
        self.repository = repository
    }

    func loadAll() async {
        isLoading = true
        defer { isLoading = false }
        do {
            items = try await repository.list()
        } catch {
            self.error = error
        }
    }

    func create(_ item: <%= it.entity.name %>) async {
        do {
            let created = try await repository.create(item)
            items.append(created)
        } catch {
            self.error = error
        }
    }

    func delete(_ id: String) async {
        do {
            try await repository.delete(id)
            items.removeAll { $0.id == id }
        } catch {
            self.error = error
        }
    }
}
