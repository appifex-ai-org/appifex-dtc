// Sources/Auth/LoginView.swift — generated by baas_auth phase
import SwiftUI
import AuthenticationServices

struct LoginView: View {
    @StateObject private var authManager = AuthManager.shared
    @State private var email = ""
    @State private var password = ""
    @State private var error: String?
    @State private var isLoading = false

    var body: some View {
        VStack(spacing: 24) {
            Text("Sign in")
                .font(.title)
                .fontWeight(.bold)

            VStack(spacing: 16) {
                TextField("Email", text: $email)
                    .textContentType(.emailAddress)
                    .keyboardType(.emailAddress)
                    .autocapitalization(.none)
                    .textFieldStyle(.roundedBorder)
                    .disabled(isLoading)

                SecureField("Password", text: $password)
                    .textContentType(.password)
                    .textFieldStyle(.roundedBorder)
                    .disabled(isLoading)
            }

            if let error {
                Text(error)
                    .font(.caption)
                    .foregroundColor(.red)
            }

            Button(action: signIn) {
                if isLoading {
                    ProgressView()
                        .frame(height: 20)
                } else {
                    Text("Sign in")
                }
            }
            .frame(maxWidth: .infinity, minHeight: 44)
            .background(Color.accentColor)
            .foregroundColor(.white)
            .cornerRadius(12)
            .disabled(isLoading)

            // Phase 4 (FIRE-02 D-01): SSO buttons below divider — Apple must appear before Google (Apple HIG)
            HStack {
                VStack { Divider() }
                Text("or").font(.caption).foregroundColor(.secondary)
                VStack { Divider() }
            }
            .padding(.vertical, 8)

            SignInWithAppleButton(.signIn) { request in
                authManager.signInWithApple()
            } onCompletion: { _ in }
                .frame(maxWidth: .infinity, minHeight: 44)
                .cornerRadius(12)
                .disabled(isLoading)

            Button(action: { Task { try? await authManager.signInWithGoogle() } }) {
                HStack {
                    Image(systemName: "globe")
                    Text("Sign in with Google")
                }
                .frame(maxWidth: .infinity, minHeight: 44)
            }
            .background(Color(.systemBackground))
            .overlay(RoundedRectangle(cornerRadius: 12).stroke(Color.secondary.opacity(0.4)))
            .cornerRadius(12)
            .disabled(isLoading)

            NavigationLink("Forgot your password?", destination: ResetPasswordView())
                .font(.body)

            NavigationLink {
                SignupView()
            } label: {
                Text("Don't have an account? Sign up")
                    .font(.body)
            }
        }
        .padding(.horizontal, 16)
        .padding(.vertical, 32)
    }

    private func signIn() {
        guard !email.isEmpty, email.contains("@"), email.contains(".") else {
            error = "Please enter a valid email address."
            return
        }
        guard !password.isEmpty else {
            error = "Incorrect email or password."
            return
        }
        isLoading = true
        error = nil
        Task {
            do {
                try await authManager.signIn(email: email, password: password)
            } catch {
                self.error = "Incorrect email or password."
            }
            isLoading = false
        }
    }
}
