// Sources/AppEntry.swift — generated by baas_auth phase
import SwiftUI
import Supabase

// Supabase client singleton — reads from environment configuration
// Replace placeholder values in .env before shipping
let supabase = SupabaseClient(
    supabaseURL: URL(string: ProcessInfo.processInfo.environment["SUPABASE_URL"] ?? "https://placeholder.supabase.co")!,
    supabaseKey: ProcessInfo.processInfo.environment["SUPABASE_ANON_KEY"] ?? "placeholder-anon-key"
)

@main
struct AppEntry: App {
    @StateObject private var authManager = AuthManager.shared

    var body: some Scene {
        WindowGroup {
            if authManager.isPasswordReset {
                NavigationStack {
                    NewPasswordView()
                }
            } else if authManager.isAuthenticated {
                ContentView()
            } else {
                NavigationStack {
                    LoginView()
                }
            }
        }
        .onOpenURL { url in
            Task { try? await supabase.auth.session(from: url) }
        }
    }
}
