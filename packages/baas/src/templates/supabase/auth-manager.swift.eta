// Sources/Auth/AuthManager.swift — generated by baas_auth phase
import Supabase

final class AuthManager: ObservableObject {
    static let shared = AuthManager()
    @Published var isAuthenticated: Bool = false
    @Published var isPasswordReset: Bool = false
    private var observationTask: Task<Void, Never>?

    private init() { observeAuthState() }

    func observeAuthState() {
        observationTask = Task {
            for await state in supabase.auth.authStateChanges {
                if state.event == .passwordRecovery {
                    await MainActor.run {
                        self.isPasswordReset = true
                        self.isAuthenticated = true
                    }
                } else if [.initialSession, .signedIn, .signedOut].contains(state.event) {
                    await MainActor.run {
                        self.isAuthenticated = state.session != nil
                        self.isPasswordReset = false
                    }
                }
            }
        }
    }

    func signIn(email: String, password: String) async throws {
        try await supabase.auth.signIn(email: email, password: password)
    }

    func signUp(email: String, password: String) async throws {
        try await supabase.auth.signUp(email: email, password: password)
    }

    func signOut() async throws {
        try await supabase.auth.signOut()
    }

    func sendPasswordReset(email: String) async throws {
        try await supabase.auth.resetPasswordForEmail(
            email: email,
            redirectUrl: URL(string: "REPLACE_URL_SCHEME://reset-password")!
        )
    }

    func confirmPasswordReset(newPassword: String) async throws {
        try await supabase.auth.updateUser { builder in
            builder.password = newPassword
        }
        isPasswordReset = false
    }
}
